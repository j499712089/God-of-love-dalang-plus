# 中转站 OpenAI 兼容接口（大脑）。Key 和模型可配；Base URL 已锁定官方中转站，不可修改
RELAY_API_KEY=
RELAY_MODEL=gpt-5.6-sol

# Jev 快速判断模型（逐条情绪/意图/好感度六维）。也走官方中转站，Base URL 已锁定，不可修改
# Key 用中转站 API Key；模型默认 jev-latest（上传 jev 后如模型名不同，改这里）
JEV_API_KEY=
JEV_MODEL=jev-latest

# 本地服务
PORT=3178
HOST=127.0.0.1

# 管理后台登录密码（访问 /manage 用）
ADMIN_PASSWORD=
